  "echeance": {
    "rule": "R415 (§4.1.5) : une lecture serveur faite AVANT l'échéance de la licence lue ne vaut plus onlineLicence après elle ; minuteur à l'échéance (min(expires − now, 24 h) + 1 ms, réarmé) qui remet onlineLicence à faux puis relit ; lecture en échec → licence inconnue ; lecture en échec ou venue du cache Firestore → onlineLicence faux",
    "constants": {
      "PLAFOND_MINUTEUR_MS": 86400000,
      "MARGE_HORS_LIGNE_MS": 259200000
    },
    "form": "input = { now, read: \"serveur\" (lecture serveur réussie) | \"cache\" (réponse du cache Firestore, fromServer faux) | \"échec\" (lecture impossible), readAt = instant (ms) de la dernière lecture SERVEUR réussie (null : inconnu), licence = dernière licence lue { pro, expires } (ms | null), cache = cache Pro de l'appareil (§2.4) } ; expect.licence = entrée licence de proState (null si read = \"échec\") ; expect.onlineLicence = read === \"serveur\" && encoreEnLigne(licence, readAt, now) ; expect.licenceDeadlineDelayMs = délai du minuteur d'échéance de la LICENCE (null : aucun ; le site arme aussi la fin de la marge hors ligne, hors de ce vecteur) ; expect.pro, reason, cache = proState({ now, override: null, store: null, onlineStore: false, licence: expect.licence, onlineLicence: expect.onlineLicence, cache })",
    "vectors": [
      {
        "id": "LE1",
        "note": "lecture serveur AVANT l'échéance, maintenant APRÈS (minuteur pas encore passé, machine en veille) : plus « en ligne » ; Pro gardé par la part licence du cache (72 h), cache NON effacé",
