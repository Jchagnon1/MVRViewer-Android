# Signature de release : README.md, section « Signature de release ».
#
# Copiez ce fichier en keystore.properties, à la racine du projet (ignoré par git),
# puis remplacez les valeurs. Ne committez JAMAIS keystore.properties ni le .jks.
# Une valeur laissée à A_REMPLACER compte comme absente : la release est refusée.

# Chemin du fichier de la clé d'ENVOI (.jks), rangé HORS du dépôt : absolu, ou ~/…
storeFile=~/Documents/Clés MVR Viewer/mvrviewer-upload.jks
# Mot de passe du fichier de clés.
storePassword=A_REMPLACER
# Alias de la clé choisi à la création (Android Studio : « Key alias »).
keyAlias=upload
# Mot de passe de la clé (souvent le même que storePassword).
keyPassword=A_REMPLACER
